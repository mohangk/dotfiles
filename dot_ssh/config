Host pongo
    HostName pongo
    User mohan
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ServerAliveInterval 15
    ServerAliveCountMax 4
    Compression no
    ForwardAgent yes

Host minipc fedora
    HostName fedora
    User mohan
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ServerAliveInterval 15
    ServerAliveCountMax 4
