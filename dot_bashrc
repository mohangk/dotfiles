# ~/.bashrc
# Shared shell config for marmoset, the Fedora minipc, and pongo.
# Keep host- or tool-specific entries guarded so the VPS can use the same file.

# Fedora/RHEL system defaults.
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# Local secrets; keep this file out of git.
if [ -f "$HOME/.secrets" ]; then
    set -a
    source "$HOME/.secrets"
    set +a
fi

# PATH helpers used by the guarded tool sections below.
path_has() {
    case ":${PATH}:" in
        *":$1:"*) return 0 ;;
        *) return 1 ;;
    esac
}

path_prepend() {
    [ -d "$1" ] || return 0
    path_has "$1" || PATH="$1${PATH:+:${PATH}}"
}

path_append() {
    [ -d "$1" ] || return 0
    path_has "$1" || PATH="${PATH:+${PATH}:}$1"
}

# User-local binaries. Chezmoi installs itself into ~/.local/bin on machines
# where the package manager does not provide it.
path_prepend "$HOME/bin"
path_prepend "$HOME/.local/bin"
export PATH

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# If not running interactively, don't do anything
case $- in
    *i*) ;;
    *) return;;
esac

# Bash-it prompt, aliases, completions, and plugins. The install directory is
# created by run_once_after_20-install-bash-it.sh and is intentionally untracked.
export BASH_IT="$HOME/.bash_it"
export BASH_IT_THEME='bobby-python'
export SCM_CHECK=true
unset MAILCHECK
[ -s "$BASH_IT/bash_it.sh" ] && source "$BASH_IT/bash_it.sh"

# SDKMAN, when installed.
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

export LESS='-R'
export GIT_EDITOR=vim

# Workstation tools shared by marmoset and the Fedora minipc. These stay guarded
# so pongo can use the same bashrc without having GUI/local-LLM tools installed.
path_append "$HOME/.lmstudio/bin"
path_prepend "$HOME/.opencode/bin"

# CUDA is present only on GPU workstations.
if [ -d /usr/local/cuda/bin ]; then
    path_prepend /usr/local/cuda/bin
fi
if [ -d /usr/local/cuda/lib64 ]; then
    export LD_LIBRARY_PATH="/usr/local/cuda/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
fi

# Language/toolchain bins.
path_append "$HOME/go/bin"

LLAMA_CPP_BIN="$HOME/Workspace/build-llama-cpp/llama.cpp/build/bin"
[ -d "$LLAMA_CPP_BIN" ] && path_append "$LLAMA_CPP_BIN"
unset LLAMA_CPP_BIN

# nvm is installed per-machine and can be absent on pongo.
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

export PATH
unset -f path_has path_prepend path_append
